project_name     = "careerdoc"
environment      = "dev"
aws_region       = "eu-west-1"

# Use the live site origin here so API Gateway, Lambda CORS, and the S3 upload
# bucket all allow the browser. Add the temporary CloudFront domain while
# testing before custom-domain DNS cutover.
frontend_origins = [
  "https://www.growpoint.bg"
  # "https://dxxxxxxxxxxxxx.cloudfront.net"
]

# Optional S3 + CloudFront frontend hosting. When enabled, Terraform creates a
# private S3 bucket and CloudFront distribution with SPA fallback to index.html.
# frontend_hosting_enabled = true
#
# Optional custom-domain certificate request. CloudFront requires ACM
# certificates in us-east-1; Terraform outputs DNS CNAME records that must be
# added in Cloudflare before the certificate can be attached to the distribution.
# frontend_certificate_domains = [
#   "growpoint.bg",
#   "www.growpoint.bg"
# ]
#
# After the certificate is ISSUED, set these and apply again:
# frontend_acm_certificate_arn = "arn:aws:acm:us-east-1:..."
# frontend_domain_aliases = [
#   "growpoint.bg",
#   "www.growpoint.bg"
# ]

# Cost / protection defaults for a small production rollout.
# Increase these only when real traffic requires it.
# api_throttle_burst_limit = 50
# api_throttle_rate_limit  = 20
#
# Optional: cap Lambda concurrency to avoid runaway spend during unexpected traffic.
# Leave unset for normal AWS-managed scaling.
# lambda_reserved_concurrency = 10

# Optional: set a stable Cognito Hosted UI domain prefix once before connecting
# Google / Apple / LinkedIn. If omitted, Terraform derives one automatically.
# cognito_domain_prefix = "growpoint-auth"

# Optional: override the exact callback/logout URLs. By default Terraform derives
# the origin, /, and /index.html from frontend_origins.
# frontend_oauth_callback_urls = [
#   "https://www.growpoint.bg/"
# ]
#
# frontend_oauth_logout_urls = [
#   "https://www.growpoint.bg/"
# ]

# Social login providers. Fill only the providers you want to activate.
# google_client_id     = ""
# google_client_secret = ""
#
# apple_client_id   = ""
# apple_team_id     = ""
# apple_key_id      = ""
# apple_private_key = <<EOF
# -----BEGIN PRIVATE KEY-----
# ...
# -----END PRIVATE KEY-----
# EOF
#
# linkedin_client_id     = ""
# linkedin_client_secret = ""

tags = {
  Project = "CareerDoc"
  Owner   = "BobSNadenica"
}

# Optional email senders.
# Cognito can send signup verification codes with its default AWS sender when
# cognito_ses_from_email is empty. Set this only after the address/domain is
# verified in SES in eu-west-1.
# cognito_ses_from_email = "contactus@growpoint.bg"
#
# Platform booking/notification emails still need a verified SES sender.
# ses_from_email = "contactus@growpoint.bg"
#
# Optional: create SES domain verification + DKIM outputs for Cloudflare DNS.
# ses_domain_identity = "growpoint.bg"
